{
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "node --import tsx scripts/generate-site-files.ts && vitepress build",
    "preview": "vitepress preview",
    "screenshots": "node --import tsx scripts/generate-doc-assets.ts",
    "a11y": "pnpm run build && playwright test",
    "a11y:install": "playwright install chromium",
    "spellcheck": "pnpm exec cspell lint \"README.md\" \"**/*.md\" --gitignore --config ../.cspell.json",
    "verify": "pnpm run build && pnpm run spellcheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@fortawesome/fontawesome-free": "catalog:",
    "@playwright/test": "catalog:",
    "playwright": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:"
  },
  "name": "@slide-spec/docs",
  "private": true,
  "type": "module"
}
